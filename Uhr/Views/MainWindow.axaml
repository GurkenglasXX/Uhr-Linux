<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Uhr.ViewModels"
        x:Class="Uhr.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/uhr.ico"
        Title="Uhr"
        Width="960" Height="680" MinWidth="600" MinHeight="480"
        Background="{DynamicResource WindowBackgroundBrush}">

    <TabControl Margin="16,8,16,0" Padding="0,16,0,0">
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource AlarmIcon}" />
                    <TextBlock Text="Wecker" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ContentControl Content="{Binding Alarms}" />
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource TimerIcon}" />
                    <TextBlock Text="Timer" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ContentControl Content="{Binding Timers}" />
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource FocusIcon}" />
                    <TextBlock Text="Pomodoro" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ContentControl Content="{Binding Pomodoros}" />
        </TabItem>
    </TabControl>
</Window>
